# Only the web preview uses Mapbox. Native iOS Apple Maps needs no map token.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Google is configured in VYRO's existing Supabase project and defaults to on.
# Use false only for a different environment without Google provider setup.
# Apple stays off until its provider setup is complete; see docs/social-login.md.
# These are public feature flags, never OAuth client secrets.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=true
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
