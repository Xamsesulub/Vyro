{
  "expo": {
    "name": "VYRO",
    "slug": "vyro",
    "platforms": [
      "ios",
      "web"
    ],
    "scheme": "vyro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "YACWFNB642",
      "bundleIdentifier": "app.vyro.xamse10",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.vyro.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VYRO bruker posisjonen din for å vise kartet og måle distansen mens du trener.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "VYRO bruker posisjonen under en økt du starter, også med låst skjerm og i andre apper når opptak med låst skjerm er slått på. GPS stoppes når du pauser eller avslutter økten."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Velg et bilde du vil dele med andre i VYRO.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.vyro.xamse10",
          "bundleIdentifier": "app.vyro.xamse10.widgets",
          "enablePushNotifications": false,
          "widgets": []
        }
      ],
      "@bacons/apple-targets",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.vyro.xamse10.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.vyro.xamse10"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "app.vyro.xamse10.watchkitapp",
                  "targetName": "VyroWatch",
                  "entitlements": {
                    "com.apple.developer.healthkit": true
                  }
                }
              ]
            }
          }
        },
        "projectId": "a7a8d578-5dbe-4bae-8835-b54a0a5469c5"
      }
    },
    "owner": "xamse10"
  }
}
